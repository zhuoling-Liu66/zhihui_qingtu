DB_URL=jdbc:mysql://localhost:3306/campus_activity_platform?useUnicode=true&characterEncoding=utf8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0
# 未设密码时留空即可
# REDIS_PASSWORD=
UPLOAD_BASE_DIR=./uploads
# JWT 签名密钥（至少 32 字节，建议随机生成）
JWT_SECRET=please_generate_a_random_secret_of_at_least_32_bytes

# ===== AI 助手（可选功能）=====
# 不配置也能正常启动：启动时会打一条 WARN，聊天接口返回规则降级结果，推荐位照常可用。
# 申请地址：https://platform.deepseek.com/api_keys
AI_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-flash
AI_DAILY_TOKENS=100000
AI_RATE_PER_MINUTE=10
